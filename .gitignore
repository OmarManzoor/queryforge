# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.*

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]          # covers .pyc, .pyo, .pyd
*.pyi              # type stub files generated by tools

# Virtual environments
.venv/
venv/
env/

# ── Testing & Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ── Build & Distribution ──────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── Local model weights ───────────────────────────────────────────────────────
local_models/

# ── HuggingFace cache (if stored inside the project) ─────────────────────────
.cache/

# ── MLX compiled artefacts ────────────────────────────────────────────────────
*.mlpackage/
*.mlmodelc/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
